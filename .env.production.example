# Copy to .env.production, replace every placeholder, and keep that file private.
APP_IMAGE=agentic-erp:latest
APP_PORT=3000
# External PostgreSQL is the default. Set to bundled-database to run the optional
# PostgreSQL container declared in docker-compose-psql.yaml.
COMPOSE_PROFILES=
DATABASE_PROVIDER=postgresql
AUTH_URL=https://erp.example.com

# External PostgreSQL connection used by both the migration and application services.
# Add or adjust TLS parameters according to your database provider's requirements.
DATABASE_URL="postgresql://agentic_erp:replace-with-a-long-random-password@db.example.com:5432/agentic_erp?schema=public&sslmode=require"

# Used only when COMPOSE_PROFILES=bundled-database. In that mode, change
# DATABASE_URL above to use postgres:5432 and remove sslmode=require.
POSTGRES_DB=agentic_erp
POSTGRES_USER=agentic_erp
POSTGRES_PASSWORD=replace-with-a-long-random-password

AUTH_SECRET=replace-with-output-from-openssl-rand-base64-32

# Used only by the explicit administrator bootstrap command.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_NAME=Administrator
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password

# Allowed values: openai, ollama.
LLM_PROVIDER=openai
OPENAI_PROVIDER_NAME=OpenAI
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_API_KEY=
OPENAI_MODEL=

# From a container, use a reachable host rather than localhost for external Ollama.
OLLAMA_PROVIDER_NAME=Ollama
OLLAMA_BASE_URL="http://host.docker.internal:11434"
OLLAMA_MODEL=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_ENTRA_ID_CLIENT_ID=
MICROSOFT_ENTRA_ID_CLIENT_SECRET=
MICROSOFT_ENTRA_ID_TENANT_ID=
